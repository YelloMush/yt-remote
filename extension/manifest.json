{
  "manifest_version": 3,
  "name": "YT Remote",
  "version": "1.0.0",
  "description": "Lets the yt-remote server on this laptop control YouTube from your phone.",
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "tabs", "alarms"],
  "host_permissions": ["*://www.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "YT Remote" }
}
